<Window x:Class="FSHWMonitor.Views.AlreadyRunningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FS HW Monitor"
        Style="{StaticResource DialogWindow}"
        Icon="/Assets/fshw.ico"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="26,24,26,22">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/fshw.ico" Width="38" Height="38" />
            <TextBlock Text="FS HW Monitor is already running" Style="{StaticResource Heading}"
                       Margin="14,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" FontSize="13.5" Margin="0,14,0,0"
                   Text="Show it brings the running dashboard to the front. Restart closes it and starts a fresh copy, which is what you want after updating the app." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button Content="Restart" Margin="10,0,0,0" Click="OnRestart" />
            <Button Content="Show it" Style="{StaticResource AccentButton}" IsDefault="True" Margin="10,0,0,0" Click="OnShow" />
        </StackPanel>
    </StackPanel>
</Window>
