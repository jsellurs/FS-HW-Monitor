<Window x:Class="FSHWMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:FSHWMonitor.Controls"
        xmlns:vm="clr-namespace:FSHWMonitor.ViewModels"
        Title="FS HW Monitor"
        Width="1280" Height="800"
        WindowStyle="None" ResizeMode="NoResize" ShowActivated="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="Assets/fshw.ico"
        FontFamily="{DynamicResource TitleFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>

        <!-- Card building blocks (shared by every card style) -->

        <DataTemplate x:Key="DetailRowTemplate" DataType="{x:Type vm:DetailItemViewModel}">
            <Border Height="29" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource BodyFont}" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- "Most used" popup -->

        <DataTemplate x:Key="UsagePanelTemplate" DataType="{x:Type vm:ComponentViewModel}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Margin="0,0,10,0" Background="{Binding AccentBrush}" />
                    <TextBlock c:Tracking.WideText="{Binding TopProcessesTitle}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding TopProcessesHint}" FontFamily="{DynamicResource BodyFont}" FontSize="11.5" Margin="14,3,0,4" Foreground="{DynamicResource MutedBrush}" />

                <ItemsControl ItemsSource="{Binding TopProcesses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TopProcessItem}">
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- App icon, or a letter badge when Windows has none to give -->
                                <Grid Grid.RowSpan="2" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Border CornerRadius="5" Background="{Binding Accent}" Opacity="0.25"
                                            Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>

                                <DockPanel Grid.Column="1" Margin="9,0,10,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontFamily="{DynamicResource BodyFont}" FontSize="12" Margin="6,1,0,0"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource BodyFont}" FontSize="14" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />

                                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="9,5,0,0" Height="3" CornerRadius="1.5"
                                        Background="{DynamicResource HairlineBrush}">
                                    <Border CornerRadius="1.5" Background="{Binding Accent}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Fraction}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Nothing busy right now." FontFamily="{DynamicResource BodyFont}" FontSize="13" Margin="14,10,0,2" Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasNoTopProcesses, Converter={StaticResource BoolToVisibility}}" />

                <!-- What the ×N counts mean -->
                <Border Margin="0,12,0,0" Padding="0,9,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairlineBrush}"
                        Visibility="{Binding HasCountNote, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding CountNote}" FontFamily="{DynamicResource BodyFont}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="UsageToolTip" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="FontFamily" Value="{DynamicResource TitleFont}" />
            <Setter Property="DataContext" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Content" Value="{Binding}" />
            <Setter Property="ContentTemplate" Value="{StaticResource UsagePanelTemplate}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Margin="12" Width="310" Padding="16,14,16,14" CornerRadius="14" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="22" Opacity="0.55" Color="Black" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tighter rows for compact cards (strip and square displays) -->
        <DataTemplate x:Key="CompactDetailRowTemplate" DataType="{x:Type vm:DetailItemViewModel}">
            <Border Height="24" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontSize="14.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource BodyFont}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CompactDetailsTemplate" DataType="{x:Type vm:ComponentViewModel}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource CompactDetailRowTemplate}" />
                <!-- Hover for the top five apps -->
                <Border Height="24" Background="Transparent" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding ShowsTopProcesses, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="600000" ToolTipService.BetweenShowDelay="0">
                    <Border.ToolTip>
                        <ToolTip Style="{StaticResource UsageToolTip}" />
                    </Border.ToolTip>
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="Most used" FontFamily="{DynamicResource BodyFont}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Path DockPanel.Dock="Right" Data="M0,0 L3.5,3.5 L0,7" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                              VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding TopProcessSummary}" VerticalAlignment="Center" FontSize="14.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{Binding AccentBrush}" />
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding Note}" FontFamily="{DynamicResource BodyFont}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarmBrush}"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Title, device name, status pill -->
        <DataTemplate x:Key="CardHeaderTemplate" DataType="{x:Type vm:ComponentViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <!-- Shrinks a long title (COOLING) on narrow cards instead of colliding with the pill -->
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="28">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="20" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" />
                            <TextBlock c:Tracking.WideText="{Binding Title}" FontSize="23" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Text="{Binding Subtitle}" FontFamily="{DynamicResource BodyFont}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding Subtitle}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Top" Margin="8,2,0,0" CornerRadius="10" Padding="10,4"
                        Background="{Binding StatusSoftBrush}">
                    <TextBlock c:Tracking.WideText="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding StatusBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Gauge (designed at 244×244; cards scale it with a Viewbox). A blurred copy underneath gives the glow. -->
        <DataTemplate x:Key="GaugeTemplate" DataType="{x:Type vm:ComponentViewModel}">
            <Grid Width="244" Height="244">
                <c:ArcGauge GlowOnly="True" Opacity="{DynamicResource GlowOpacity}"
                            Value="{Binding GaugeValue}" Minimum="{Binding GaugeMin}" Maximum="{Binding GaugeMax}"
                            Warn="{Binding GaugeWarn}" Crit="{Binding GaugeCrit}" AccentColor="{Binding AccentColor}"
                            WarnColor="{DynamicResource WarmColor}" HotColor="{DynamicResource HotColor}">
                    <c:ArcGauge.Effect>
                        <BlurEffect Radius="16" />
                    </c:ArcGauge.Effect>
                </c:ArcGauge>
                <c:ArcGauge Value="{Binding GaugeValue}" Minimum="{Binding GaugeMin}" Maximum="{Binding GaugeMax}"
                            Warn="{Binding GaugeWarn}" Crit="{Binding GaugeCrit}" AccentColor="{Binding AccentColor}"
                            LowMarker="{Binding LowMarker}" HighMarker="{Binding HighMarker}"
                            WarnColor="{DynamicResource WarmColor}" HotColor="{DynamicResource HotColor}"
                            LowMarkerColor="{DynamicResource LowStatColor}" HighMarkerColor="{DynamicResource HighStatColor}"
                            TickColor="{DynamicResource TickColor}" LabelColor="{DynamicResource MutedColor}"
                            DimAlpha="{DynamicResource GaugeDimAlpha}" />

                <!-- Shrinks only if a wide theme font would otherwise touch the ring -->
                <Viewbox Width="158" StretchDirection="DownOnly" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ValueText}" FontSize="70" FontWeight="SemiBold"
                                       Foreground="{Binding ValueBrush}" />
                            <TextBlock Text="{Binding UnitText}" FontSize="21" Margin="2,13,0,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock c:Tracking.WideText="{Binding SensorName}" FontSize="11" Margin="0,-4,0,0" MaxWidth="150"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <!-- High / Avg / Low -->
        <DataTemplate x:Key="StatsTemplate" DataType="{x:Type vm:ComponentViewModel}">
            <Border CornerRadius="12" Padding="0,9,0,8" BorderThickness="1"
                    Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource InsetBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock c:Tracking.WideText="High" FontSize="10.5" FontWeight="SemiBold" LineHeight="14" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource HighStatBrush}" />
                        <TextBlock Text="{Binding HighText}" FontSize="26" FontWeight="SemiBold" LineHeight="31" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" Margin="0,4" />
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock c:Tracking.WideText="Avg" FontSize="10.5" FontWeight="SemiBold" LineHeight="14" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center"
                                   Foreground="{Binding AccentBrush}" />
                        <TextBlock Text="{Binding AvgText}" FontSize="26" FontWeight="SemiBold" LineHeight="31" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" Margin="0,4" />
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock c:Tracking.WideText="Low" FontSize="10.5" FontWeight="SemiBold" LineHeight="14" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource LowStatBrush}" />
                        <TextBlock Text="{Binding LowText}" FontSize="26" FontWeight="SemiBold" LineHeight="31" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Secondary sensors -->
        <DataTemplate x:Key="DetailsTemplate" DataType="{x:Type vm:ComponentViewModel}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                <!-- Hover for the top five apps -->
                <Border Height="29" Background="Transparent" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding ShowsTopProcesses, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="600000" ToolTipService.BetweenShowDelay="0">
                    <Border.ToolTip>
                        <ToolTip Style="{StaticResource UsageToolTip}" />
                    </Border.ToolTip>
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="Most used" FontFamily="{DynamicResource BodyFont}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Path DockPanel.Dock="Right" Data="M0,0 L3.5,3.5 L0,7" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                              VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding TopProcessSummary}" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{Binding AccentBrush}" />
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding Note}" FontFamily="{DynamicResource BodyFont}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarmBrush}"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- History chart -->
        <DataTemplate x:Key="HistoryTemplate" DataType="{x:Type vm:ComponentViewModel}">
            <Grid MinHeight="50">
                <Border CornerRadius="11" BorderThickness="1"
                        Background="{DynamicResource ChartBrush}" BorderBrush="{DynamicResource ChartBorderBrush}" />
                <c:Sparkline Margin="1,22,1,7" Buffer="{Binding History}" Version="{Binding HistoryVersion}"
                             LineColor="{Binding AccentColor}" GridColor="{DynamicResource ChartGridColor}" />
                <TextBlock c:Tracking.WideText="{Binding HistoryLabel}" FontSize="10" Margin="11,7,0,0"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding HistoryRangeText}" FontSize="12" Margin="0,5,11,0"
                           VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Landscape: tall cards side by side -->
        <DataTemplate x:Key="ColumnCardTemplate" DataType="{x:Type vm:ComponentViewModel}">
            <Border CornerRadius="18" BorderThickness="1" Padding="18,16,18,14"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}">
                <Border.InputBindings>
                    <!-- Double-click a card to reset its high / avg / low. -->
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ResetCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardHeaderTemplate}" Focusable="False" />
                    <Viewbox Grid.Row="1" Margin="0,10,0,0" MaxWidth="244" MaxHeight="244" HorizontalAlignment="Center">
                        <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource GaugeTemplate}" />
                    </Viewbox>
                    <ContentControl Grid.Row="2" Margin="0,4,0,0" Focusable="False"
                                    Content="{Binding}" ContentTemplate="{StaticResource StatsTemplate}" />
                    <!-- Fixed height (5 rows + Most used) so the history charts line up across cards -->
                    <ContentControl Grid.Row="3" Margin="2,10,2,0" Height="180" Focusable="False"
                                    Content="{Binding}" ContentTemplate="{StaticResource DetailsTemplate}" />
                    <ContentControl Grid.Row="4" Margin="0,8,0,0" Focusable="False"
                                    Content="{Binding}" ContentTemplate="{StaticResource HistoryTemplate}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Portrait: wide cards stacked -->
        <DataTemplate x:Key="RowCardTemplate" DataType="{x:Type vm:ComponentViewModel}">
            <Border CornerRadius="18" BorderThickness="1" Padding="10,10,18,10"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ResetCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="242" />
                    </Grid.ColumnDefinitions>
                    <Viewbox MaxWidth="232" MaxHeight="232" VerticalAlignment="Center">
                        <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource GaugeTemplate}" />
                    </Viewbox>
                    <Grid Grid.Column="1" Margin="14,4,18,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource CardHeaderTemplate}" />
                        <ContentControl Grid.Row="1" Margin="0,10,0,0" Focusable="False"
                                        Content="{Binding}" ContentTemplate="{StaticResource StatsTemplate}" />
                        <ContentControl Grid.Row="2" Margin="0,10,0,0" Focusable="False"
                                        Content="{Binding}" ContentTemplate="{StaticResource HistoryTemplate}" />
                    </Grid>
                    <ContentControl Grid.Column="2" VerticalAlignment="Center" Focusable="False"
                                    Content="{Binding}" ContentTemplate="{StaticResource DetailsTemplate}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Strip and square displays: gauge beside everything else -->
        <DataTemplate x:Key="CompactCardTemplate" DataType="{x:Type vm:ComponentViewModel}">
            <Border CornerRadius="18" BorderThickness="1" Padding="10,10,16,10"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ResetCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="232" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox VerticalAlignment="Center">
                        <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource GaugeTemplate}" />
                    </Viewbox>
                    <Grid Grid.Column="1" Margin="12,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource CardHeaderTemplate}" />
                        <ContentControl Grid.Row="1" Margin="0,8,0,0" Focusable="False"
                                        Content="{Binding}" ContentTemplate="{StaticResource StatsTemplate}" />
                        <ContentControl Grid.Row="2" Margin="0,6,0,0" Focusable="False"
                                        Content="{Binding}" ContentTemplate="{StaticResource CompactDetailsTemplate}" />
                        <ContentControl Grid.Row="3" Margin="0,8,0,0" Focusable="False"
                                        Content="{Binding}" ContentTemplate="{StaticResource HistoryTemplate}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <!-- Laid out on a design canvas sized by Platform/LayoutPlanner.cs and scaled to the window. -->
        <Grid x:Name="Root" Width="1280" Height="800" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Backdrop -->
            <Rectangle Grid.RowSpan="3" Fill="{DynamicResource BackdropBrush}" />
            <Rectangle Grid.RowSpan="3" Fill="{DynamicResource BackdropGlowABrush}" />
            <Rectangle Grid.RowSpan="3" Fill="{DynamicResource BackdropGlowBBrush}" />

            <!-- Header -->
            <Grid Grid.Row="0" MinHeight="56" Margin="26,14,26,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="46" Height="46">
                        <!-- Gauge-ring mark (most themes) -->
                        <Grid Visibility="{DynamicResource LogoRingVisibility}">
                            <Path Stroke="{DynamicResource DividerBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 9.57,36.43 A 19,19 0 1 1 36.43,36.43" />
                            <Path Stroke="{DynamicResource SpectrumBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 9.57,36.43 A 19,19 0 1 1 36.43,36.43">
                                <Path.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="12" Color="{DynamicResource LogoGlowColor}" Opacity="0.6" />
                                </Path.Effect>
                            </Path>
                            <TextBlock Text="FS" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,0,0,1" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                        <!-- Brand mark (Full Send theme) -->
                        <Image Source="{DynamicResource LogoImageSource}" Visibility="{DynamicResource LogoImageVisibility}"
                               Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="23" FontWeight="Bold" LineHeight="30" LineStackingStrategy="BlockLineHeight">
                            <Run Text="{DynamicResource TitleBrandText}" Foreground="{DynamicResource SpectrumBrush}" /><Run Text="{DynamicResource TitleRestText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </TextBlock>
                        <TextBlock c:Tracking.WideText="Hardware temperatures" FontSize="10" Margin="1,2,0,0"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ClockText}" FontSize="36" FontWeight="Light" LineHeight="42" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ClockSuffix}" FontSize="14" Margin="5,0,0,7" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock c:Tracking.WideText="{Binding DateText}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,-3,1,0"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </Grid>

            <!-- Cards (template, panel and spacing are set per layout in code) -->
            <ItemsControl x:Name="CardsHost" Grid.Row="1" ItemsSource="{Binding Components}" />

            <!-- Footer -->
            <Grid Grid.Row="2" MinHeight="18" Margin="28,11,28,11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="FooterLeft" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock c:Tracking.WideText="{Binding SessionText}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="   ·   " FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock c:Tracking.WideText="{Binding UptimeText}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <TextBlock x:Name="FooterBanner" c:Tracking.WideText="{Binding Banner}" FontSize="10.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WarmBrush}"
                           Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock x:Name="FooterRight" c:Tracking.WideText="{Binding FooterRight}" FontSize="10.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            </Grid>

            <!-- Short notices ("already running", "theme saved"...) -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                    CornerRadius="16" Padding="20,10" BorderThickness="1"
                    Background="{DynamicResource PillBrush}" BorderBrush="{DynamicResource PillBorderBrush}"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <TextBlock Text="{Binding Toast}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>

            <!-- Night mode: a black veil over everything -->
            <Rectangle x:Name="NightVeil" Grid.RowSpan="3" Fill="Black" Opacity="0" IsHitTestVisible="False" />
        </Grid>
    </Viewbox>
</Window>
